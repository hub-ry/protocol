[Unit]
Description=Protocol weight tracker
# Don't start until Docker itself is running
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# "oneshot" means systemd runs the command and considers the service started
# once it exits. RemainAfterExit=yes means systemd still considers the service
# "active" after the command finishes, so `systemctl stop` works correctly.
RemainAfterExit=yes
WorkingDirectory=/home/ryan-hubbart/protocol
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# No timeout — pulling images on first boot can take a while
TimeoutStartSec=0

[Install]
# Start when the system reaches normal multi-user mode (i.e. on every boot)
WantedBy=multi-user.target
